# Variables del despliegue publico. NO se commitea el .env real.
# En Render se cargan en Environment (las marcadas sync:false en render.yaml).

# --- Postgres gestionado (Neon) ---
PG_HOST=ep-xxxx-xxxx.sa-east-1.aws.neon.tech
PG_PORT=5432
PG_DATABASE=abastecimiento_bi
PG_USER=abastecimiento_bi_owner
PG_PASSWORD=xxxxxxxxxxxx
PG_SSLMODE=require

# --- Grafana ---
GF_SECURITY_ADMIN_PASSWORD=pon-una-clave-larga-y-unica
GF_SERVER_ROOT_URL=https://abastecimiento-2026.onrender.com
GF_SERVER_HTTP_PORT=10000
